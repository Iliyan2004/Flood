# Copy to .env (git-ignored). Never commit real values.
MAPBOX_TOKEN=pk.your-mapbox-public-token
# Optional: reads vector layers (roads, hospitals, schools, power, rail, airports) from a PostGIS instead of local files.
# SAILAB_PG_URL=postgresql://user:password@localhost:5455/simcity
# Optional: require this token for requests from other machines (local requests are exempt).
# SAILAB_ACCESS_TOKEN=change-me
# Optional overrides of dataset locations; every path is listed in data_paths.py as SAILAB_<NAME>.
# SAILAB_SHARE=/path/to/DGX-Shared
